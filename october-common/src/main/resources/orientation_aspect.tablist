# Entries here have the form:
# ID[<TAB>allows_down][<TAB>allows_up][<TAB>allows_flipped]
#
# If allows_down, allows_up, or allows_flipped are specified, this block can have a downward, upward, or flipped
# orientations.  Otherwise, it can only be flat.
#
# Anything not referenced here, which is a block, will always use the default "NORTH" orientation (ie: "none").
# Note that the ID references are against block_aspect.tablist.

op.hopper	allows_down
op.emitter
op.diode
op.and_gate
op.or_gate
op.not_gate
op.sensor_inventory
op.portal_keystone
op.block_mover	allows_down	allows_up
op.stone_brick_slab	allows_down	allows_up
op.stone_brick_stair	allows_flipped
op.wood_plank_slab	allows_down	allows_up
op.wood_plank_stair	allows_flipped
op.door
op.torch	allows_down
op.branch	allows_down
