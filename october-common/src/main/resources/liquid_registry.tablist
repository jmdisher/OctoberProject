# Entries here have the form:
# ID<TAB>[creates_source]
# <TAB>flow_delay_millis<TAB>millis
# <TAB>full_bucket<TAB>ID
# <TAB>empty_bucket<TAB>ID
# <TAB>solid_block<TAB>ID
# <TAB>flow_distance<TAB>int
#
# Note that the ID references are against item_registry.tablist.

op.water_source	creates_source
	flow_delay_millis	100
	full_bucket	op.bucket_water
	empty_bucket	op.bucket_empty
	solid_block	op.stone
	flow_distance	2
op.lava_source
	flow_delay_millis	1000
	full_bucket	op.bucket_lava
	empty_bucket	op.bucket_empty
	solid_block	op.basalt
	flow_distance	2
